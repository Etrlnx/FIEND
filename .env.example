# SEC EDGAR API User-Agent (Required by SEC)
SEC_EDGAR_USER_AGENT=FIENDResearch your-email@domain.com

# LLM Providers (Configure at least one)
# Switch provider with LLM_PROVIDER: gemini | anthropic | openai | ollama
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
COHERE_API_KEY=

# Default Models
# LLM Provider: gemini | anthropic | openai | ollama
LLM_PROVIDER=ollama
# Model names per provider:
#   gemini: gemini-2.5-flash, gemini-2.5-pro, gemini-1.5-flash
#   anthropic: claude-3-5-sonnet-20241022, claude-3-haiku-20240307
#   openai: gpt-4o, gpt-4o-mini, gpt-3.5-turbo
#   ollama: llama3.2, mistral, phi3, qwen2.5
DEFAULT_LLM_MODEL=llama3.2
DEFAULT_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# LLM Generation Settings
LLM_TEMPERATURE=0.1
# LLM_RPM throttles cloud providers only; ollama is never throttled
LLM_RPM=10
# Cap on answer length. Longest eval answer ~460 tokens; prompt (max ~2.4k) + 768 fits Ollama's 4096 ctx
LLM_MAX_TOKENS=768
# Ollama: keep models loaded between queries (default 30m); qwen3 hidden thinking (~6x slower) off by default
OLLAMA_KEEP_ALIVE=30m
OLLAMA_REASONING=false

# Embedding Provider
EMBEDDING_PROVIDER=huggingface
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
HF_TOKEN=

# Project Paths
DATA_DIR=data
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
VECTOR_STORE_DIR=data/vector_stores/phase6_table_aware